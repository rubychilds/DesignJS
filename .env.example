# DesignJS environment variables — copy to .env (gitignored)
# All env vars are OPTIONAL today; v0.1 runs with zero config.
# The list below covers known v0.2/v0.3 needs so contributors know
# what's coming. Add new vars to packages/app/src/env.ts schema too.

# === Bridge ===
# Override the WebSocket bridge port (default: 29170)
# DESIGNJS_BRIDGE_PORT=29170

# Bridge auth token (auto-generated by Vite plugin per session;
# only override for testing or non-standard MCP-server spawn patterns).
# See ADR-0015 (Proposed) for the auth design.
# DESIGNJS_BRIDGE_TOKEN=

# === AI providers (v0.2 chat panel) ===
# These are read by the chat panel ONLY when the user has selected
# the corresponding provider in Settings → AI Providers. Storage is
# in ~/.designjs/secrets.json (mode 0o600) per ADR-0017 (Proposed) —
# env vars are the alternate path for headless / CI / power-user use.
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_AI_API_KEY=

# === Cloud tier (post-v0.2, Supabase) — ADR-0013 (Proposed) ===
# These are ONLY needed for the future hosted/cloud tier. Local-first
# DesignJS doesn't read them. Server-side (Edge Functions) only —
# never expose SERVICE_ROLE_KEY to a browser bundle.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=

# === Observability (opt-in only) — ADR-0014 (Proposed, not yet drafted) ===
# Both default to OFF. User must explicitly opt in via Settings → Privacy.
# SENTRY_DSN=
# POSTHOG_PROJECT_API_KEY=
